        iframe.id = 'general_iframe';
        iframe.srcdoc = "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta http-equiv=\"Permissions-Policy\" content=\"bluetooth=(self)\" />\n  <meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'self'; connect-src 'self' https://*.payclip.io https://*.payclip.com https://*.clip.mx https://*.online-metrix.net https://h.online-metrix.net https://api.ipify.org https://ipinfo.io https://rum.browser-intake-datadoghq.com https://*.datadoghq.com; script-src 'self' 'unsafe-inline' https://*.payclip.com https://*.clip.mx https://*.payclip.io https://*.online-metrix.net https://h.online-metrix.net https://www.datadoghq-browser-agent.com; frame-src 'self' https://*.online-metrix.net https://h.online-metrix.net https://*.payclip.io https://*.payclip.com https://*.clip.mx; img-src 'self' https://*.online-metrix.net https://h.online-metrix.net data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; worker-src blob: 'self'; base-uri 'self'; form-action 'self'\" />\n  <!-- Datadog RUM -->\n  <!-- Cargamos el agente sin async para garantizar orden -->\n  <script src=\"https://www.datadoghq-browser-agent.com/datadog-rum.js\"></script>\n  <script>\n    try {\n      window.__RW_VERSION = '0.2.20';\n      console.info('[risk-wrapper] version=0.2.20');\n    } catch(_) {}\n\n    var WEBVIEW_DETECTION_REGEX = /(iPhone|iPod|iPad).*AppleWebKit(?!.*Safari)|; wv|WebView/i;\n\n    var __RW_CSP_CFG = {\n      enabled: true,\n      mode: 'enforce-only',\n      sample: 1,\n      limit: 3\n    };\n\n    function __sendCSPReport(payload){\n      try {\n        var data = new Blob([JSON.stringify(payload)], { type: 'application/json' });\n        if (navigator.sendBeacon && navigator.sendBeacon('/api/csp-report', data)) return;\n      } catch(_) {}\n      try {\n        fetch('/api/csp-report', {\n          method: 'POST',\n          headers: { 'Content-Type': 'application/json' },\n          body: JSON.stringify(payload),\n          keepalive: true,\n          credentials: 'same-origin'\n        }).catch(function(){ /* ignore */ });\n      } catch(_) {}\n    }\n\n    function __shouldReport(details){\n      try {\n        if (!__RW_CSP_CFG.enabled) return false;\n        if (Math.random() > Number(__RW_CSP_CFG.sample || 1)) return false;\n        if ((__RW_CSP_CFG.mode || 'enforce-only') === 'enforce-only' && details && details.disposition && details.disposition !== 'enforce') {\n          return false;\n        }\n        var count = Number(sessionStorage.getItem('rw_csp_count') || '0');\n        if (count >= Number(__RW_CSP_CFG.limit || 3)) return false;\n        var key = String(details.effectiveDirective || details.violatedDirective || 'unknown') + '|' + String(details.blockedURI || details.filename || 'unknown');\n        var seenRaw = sessionStorage.getItem('rw_csp_seen') || '{}';\n        var seen = {};\n        try { seen = JSON.parse(seenRaw) || {}; } catch(_) { seen = {}; }\n        if (seen[key]) return false;\n        seen[key] = 1;\n        sessionStorage.setItem('rw_csp_seen', JSON.stringify(seen));\n        sessionStorage.setItem('rw_csp_count', String(count + 1));\n        return true;\n      } catch(_) { return true; }\n    }\n\n    function __reportCSP(details){\n      if (!__shouldReport(details)) return;\n\n      var browserInfo = {\n        ua: navigator.userAgent,\n        vendor: navigator.vendor || '',\n        platform: navigator.platform || '',\n        isWebView: WEBVIEW_DETECTION_REGEX.test(navigator.userAgent)\n      };\n\n      var payload = {\n        session_id: \"f8302f60-95c1-42f6-b080-1098547730f4\",\n        event: 'cspViolation',\n        details: details,\n        browser: browserInfo,\n        timestamp: new Date().toISOString()\n      };\n\n      // 1) RUM\n      try {\n        window.DD_RUM && window.DD_RUM.addError && window.DD_RUM.addError('cspViolation', payload);\n      } catch (err) {\n        // Minimal logging for debugging if DD_RUM fails\n        console.warn('[risk-wrapper] DD_RUM.addError failed:', err.message || err);\n      }\n\n      // 2) Notify host with secure origin\n      try {\n        var targetOrigin = window.location.ancestorOrigins && window.location.ancestorOrigins[0];\n        if (!targetOrigin && document.referrer) {\n          try {\n            targetOrigin = new URL(document.referrer).origin;\n          } catch (_) {\n            targetOrigin = window.location.origin;\n          }\n        }\n        if (!targetOrigin) {\n          targetOrigin = window.location.origin;\n        }\n\n        // If we couldn't determine a trusted origin, sanitize the payload\n        var messagePayload = payload;\n        if (!document.referrer || targetOrigin === window.location.origin) {\n          // Sanitized version without sensitive data\n          messagePayload = {\n            event: payload.event,\n            timestamp: payload.timestamp,\n            details: payload.details\n            // NO session_id or browser fingerprints\n          };\n        }\n\n        window.parent && window.parent.postMessage({\n          type: 'riskWrapperIframeError',\n          source: 'CSP',\n          error: messagePayload\n        }, targetOrigin);\n      } catch (_) {}\n\n      __sendCSPReport(payload);\n    }\n\n    document.addEventListener && document.addEventListener('securitypolicyviolation', function(e) {\n      var details = {\n        violatedDirective: e.violatedDirective,\n        effectiveDirective: e.effectiveDirective,\n        blockedURI: e.blockedURI,\n        disposition: e.disposition,\n        originalPolicy: e.originalPolicy\n      };\n      __reportCSP(details);\n    });\n\n    window.addEventListener && window.addEventListener('error', function(e){\n      try {\n        var msg = (e && e.message ? String(e.message) : '').toLowerCase();\n        if (msg.indexOf('content security policy') !== -1) {\n          __reportCSP({ fallback: true, message: e.message || 'CSP blocked resource', filename: e.filename, lineno: e.lineno, colno: e.colno, disposition: 'unknown' });\n        }\n      } catch(_) {}\n    });\n\n    if (window.DD_RUM && typeof window.DD_RUM.onReady === 'function') {\n      window.DD_RUM.onReady(() => {\n        window.DD_RUM.init({\n          clientToken: 'pub0352a299b9aa54f978521faec7dd40a5',\n          applicationId: 'e69d009a-4440-48eb-b37c-21928a14dc16',\n        site: 'datadoghq.com',\n        service: 'txo-wallet',\n        env: 'prod',\n        sampleRate: 100,\n        trackInteractions: true,\n        trackViewsManually: true\n      });\n\n        // El iframe de risk corre como srcdoc (URL about:srcdoc), asi que RUM\n        // auto-nombra la view 'srcdoc' y colapsa todo el risk-collector en una\n        // view sin identidad. Con trackViewsManually la controlamos a mano y le\n        // damos un nombre propio para separarla del wallet real (/wallet/*).\n        window.DD_RUM.startView({ name: 'risk-collector' });\n\n      function getRUMContext(extra = {}) {\n        return {\n          session_id: \"f8302f60-95c1-42f6-b080-1098547730f4\",\n          version: '0.2.20',\n          integration: 'risk-wrapper',\n          host: window.location.host,\n          referrer: document.referrer,\n          ...extra\n        };\n      }\n\n      // cybersourceScriptError es esperado (~2% de las cargas: online-metrix\n      // es un dominio de fingerprinting que los privacy tools/webviews\n      // bloquean, o timeoutea en redes móviles lentas). Va como action para\n      // poder medirlo sin contaminar Error Tracking con fallos de un tercero.\n      const EXPECTED_FAILURES = ['cybersourceScriptError'];\n\n      function registerRUMEvent(name, payload = {}) {\n        if (name.endsWith('Error') && !EXPECTED_FAILURES.includes(name)) {\n          window.DD_RUM.addError?.(name, getRUMContext(payload));\n        } else {\n          window.DD_RUM.addAction?.(name, getRUMContext(payload));\n        }\n      }\n\n      const successEvents = [\n        ['riskWrapperReady', {}],\n        ['cybersourceScriptLoaded', { integration: 'cybersource' }],\n        ['forterIframeLoaded', { integration: 'forter' }],\n        ['clipIframeLoaded', { integration: 'clip' }],\n      ];\n      const errorEvents = [\n        ['riskWrapperError', { integration: 'risk-wrapper' }],\n        ['cybersourceScriptError', { integration: 'cybersource' }],\n        ['forterIframeError', { integration: 'forter' }],\n        ['clipIframeError', { integration: 'clip' }],\n      ];\n\n      successEvents.forEach(([evt, payload]) =>\n        window.addEventListener(evt, () => registerRUMEvent(evt, payload))\n      );\n      errorEvents.forEach(([evt, payload]) =>\n        window.addEventListener(evt, e => registerRUMEvent(evt, {\n          error: e.detail?.error ?? e,\n          error_stack: e.detail?.error?.stack,\n          ...payload\n        }))\n      );\n\n      window.addEventListener('message', event => {\n        if (event.data?.type === 'riskWrapperIframeError') {\n          registerRUMEvent('riskWrapperIframeError', {\n            source: event.data.source,\n            error: event.data.error\n          });\n        }\n      });\n    });\n    } else {\n      console.warn('[risk-wrapper] DD_RUM not available, continuing without RUM tracking');\n    }\n  </script>\n</head>\n<body>\n  <iframe\n    id=\"forter_iframe\"\n    src=\"https://elements.clip.mx/forter/forter_p.html?session_id=f8302f60-95c1-42f6-b080-1098547730f4\"\n    style=\"display:none;\"\n  ></iframe>\n\n  <script>\n    (function loadCybersource() {\n      try {\n        var CYBERSOURCE_TIMEOUT_MS = 10000;\n        var SESSION_PREFIX = 'clip_mx';\n        var sessionId = \"f8302f60-95c1-42f6-b080-1098547730f4\";\n        var orgId = 'k8vif92e';\n        var encodedSessionId = encodeURIComponent(SESSION_PREFIX + sessionId);\n        var scriptUrl = 'https://h.online-metrix.net/fp/tags.js?org_id=' + orgId + '&session_id=' + encodedSessionId;\n\n        function sanitizeUrl(url) {\n          try {\n            return url.replace(/session_id=[^&]*/g, 'session_id=[REDACTED]');\n          } catch(_) { return '[URL]'; }\n        }\n\n        console.log('[risk-wrapper] Loading Cybersource:', sanitizeUrl(scriptUrl));\n\n        var script = document.createElement('script');\n        script.id = 'cybersource_script';\n        script.src = scriptUrl;\n        script.type = 'text/javascript';\n        script.async = true;\n\n        var isLoaded = false;\n        var errorReported = false;\n        var timeout;\n\n        function handleError(errorType, errorDetails) {\n          if (isLoaded || errorReported) return;\n\n          errorReported = true;\n          clearTimeout(timeout);\n\n          var errorInfo = {\n            type: errorType || 'script_load_error',\n            url: scriptUrl,\n            timestamp: new Date().toISOString(),\n            userAgent: navigator.userAgent,\n            vendor: navigator.vendor || '',\n            platform: navigator.platform || '',\n            online: navigator.onLine,\n            isWebView: WEBVIEW_DETECTION_REGEX.test(navigator.userAgent),\n            details: errorDetails\n          };\n\n          var consoleWarnInfo = Object.assign({}, errorInfo, { url: sanitizeUrl(errorInfo.url) });\n          // warn, no error: RUM captura console.error como error event, lo que\n          // duplicaría el reporte del CustomEvent de abajo (vía registerRUMEvent).\n          console.warn('[risk-wrapper] Cybersource failed:', consoleWarnInfo);\n\n          window.dispatchEvent(new CustomEvent('cybersourceScriptError', {\n            detail: { error: errorInfo }\n          }));\n        }\n\n        script.onload = function() {\n          isLoaded = true;\n          clearTimeout(timeout);\n          console.log('[risk-wrapper] Cybersource script loaded successfully');\n          window.dispatchEvent(new Event('cybersourceScriptLoaded'));\n        };\n\n        script.onerror = function(event) {\n          handleError('script_load_error', {\n            eventType: event ? event.type : 'unknown',\n            isTrusted: event ? event.isTrusted : false\n          });\n        };\n\n        timeout = setTimeout(function() {\n          if (!isLoaded) {\n            handleError('script_timeout', { reason: 'timeout_after_10s' });\n          }\n        }, CYBERSOURCE_TIMEOUT_MS);\n\n        document.body.appendChild(script);\n      } catch (err) {\n        console.warn('[risk-wrapper] Error loading Cybersource:', err);\n        window.dispatchEvent(new CustomEvent('cybersourceScriptError', {\n          detail: { error: { message: err.message, stack: err.stack } }\n        }));\n      }\n    })();\n\n    (function() {\n      let readyCount = 0;\n\n      const resources = [\n        { kind: 'iframe', id: 'forter_iframe', loadEvt: 'forterIframeLoaded', errEvt: 'forterIframeError' },\n        { kind: 'iframe', id: 'clip_iframe', loadEvt: 'clipIframeLoaded', errEvt: 'clipIframeError' }\n      ];\n      const expected = resources.length + 1; // +1 to include Cybersource\n\n      function checkReady() {\n        if (++readyCount === expected) {\n          window.dispatchEvent(new CustomEvent('riskWrapperReady'));\n        }\n      }\n\n      // Listen for Cybersource loaded event\n      window.addEventListener('cybersourceScriptLoaded', checkReady);\n\n      resources.forEach(r => {\n        if (r.kind === 'iframe') {\n          const el = document.getElementById(r.id);\n          if (!el) return;\n          el.addEventListener('load', () => {\n            checkReady();\n            window.dispatchEvent(new Event(r.loadEvt));\n          });\n          el.addEventListener('error', e => {\n            console.error('[risk-wrapper] Iframe error:', r.id, e);\n            window.dispatchEvent(new CustomEvent(r.errEvt, { detail: { error: e.message || e } }));\n          });\n        }\n      });\n    })();\n  </script>\n\n  <iframe\n    id=\"clip_iframe\"\n    src=\"https://elements.clip.mx/clip/clip_collector_p.html?session_id=f8302f60-95c1-42f6-b080-1098547730f4\"\n    style=\"display:none;\"\n  ></iframe>\n</body>\n</html>";
        document.body.appendChild(iframe);
      } catch (err) {
        console.error('Error principal risk-wrapper:', err);
        window.dispatchEvent(new CustomEvent('riskWrapperError', {
          detail: { error: err && (err.message || String(err)) }
        }));
      }
    })();